  './lib/firebaseAuth': {
    initAuth: (onUser: any, onUnauth: any) => {
      mockImports['./lib/firebaseAuth']._triggerUser = (u: any, t: any) => {
        onUser(u, t);
      };
      return () => {};
    },
    logout: async () => {
