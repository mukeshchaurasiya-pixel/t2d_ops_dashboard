            // Wait, did it render the Restricted Access view?
            const stringified = JSON.stringify(output);
            const hasLockIcon = stringified.includes('Lock') || stringified.includes('LockIcon');
            const hasRestrictedMsg = stringified.includes('Access Restricted');
            
