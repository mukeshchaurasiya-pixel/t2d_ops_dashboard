export function normalizeHeaderKey(header) {
  return String(header ?? '')
    .trim()
    .toLowerCase()
    .replace(/[\r\n\t]+/g, ' ')
    .replace(/\s+/g, ' ');
}

export function resolveCaseRowField(header) {
  const normalized = normalizeHeaderKey(header);
  return CASE_ROW_FIELD_MAP[normalized] || CASE_ROW_FIELD_MAP[normalized.replace(/[\s_?]/g, '')];
}

export function coerceCaseRowValue(field, rawValue) {
  if (CASE_ROW_NUMERIC_FIELDS.includes(field)) {
    return parseFloat(String(rawValue || '').replace(/[^0-9.-]/g, '')) || 0;
  }
  return rawValue;
}

