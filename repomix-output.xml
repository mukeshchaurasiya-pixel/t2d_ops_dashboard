} from '../types';
import { buildCharts, buildKpis } from '../data/mockData';
import { calculateOperationsMatrix } from './matrixCalculator';

const EMPTY_KPIS: DashboardKpis = {
  totalCases: 0,
  activeTokens: 0,
  delivered: 0,
  cancelled: 0,
  bookingsWithTasks: 0,
  totalTaskInstances: 0,
