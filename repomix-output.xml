            searchTree(output);
            if (dashboardElement) dashboardFound = true;

            console.log("Dashboard rendered:", dashboardFound);
            console.log("Has Restricted Access Message:", hasRestrictedMsg);
            console.log("Has Lock Icon:", hasLockIcon);
            
            if (hasRestrictedMsg && !dashboardFound) {
              console.log("PASS: Correctly rendered Restricted Access page and did not render Dashboard.");
            } else {
              console.error("FAIL: Did not show Restricted Access screen or Dashboard was incorrectly rendered.");
              process.exit(1);
